<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Accept Bluetooth Low Energy connections from your paired iPhone or iPad.</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Sofa Remote lets your paired iPhone or iPad control this Mac on your local network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_sofaremote._tcp</string>
    </array>
</dict>
</plist>
