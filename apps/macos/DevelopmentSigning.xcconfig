// Local installations require a persistent certificate identity. CI overrides
// this explicitly with ad-hoc signing and must not be used for installation.
// An intentionally unavailable identity makes unconfigured Xcode builds fail.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = SOFA_REMOTE_CONFIGURE_DEVELOPMENT_SIGNING_FIRST
#include? "DevelopmentSigning.local.xcconfig"
