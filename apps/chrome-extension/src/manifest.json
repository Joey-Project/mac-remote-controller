{
  "manifest_version": 3,
  "name": "Sofa Remote",
  "version": "0.1.0",
  "description": "Control selected YouTube and Bilibili tabs from Sofa Remote.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.bilibili.com/*",
    "https://bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.bilibili.com/*",
        "https://bilibili.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
