+import Foundation
+import ArgumentParser
+import XKit
+import DeveloperAPI
+import Dependencies
+
+/// Research-only command; does not invoke certificate creation or revocation.
+struct DSRenewalProbeCommand: AsyncParsableCommand {
+    static let configuration = CommandConfiguration(commandName: "renewal-probe")
+
+    enum Mode: String, ExpressibleByArgument {
+        case storage, preflight, inspect, registerDevice = "register-device", createProfile = "create-profile"
+        case renewProfile = "renew-profile", appProfile = "app-profile", macProfile = "mac-profile"
+        case widgetProfile = "widget-profile"
+    }
+    @Argument var mode: Mode
+
+    private struct Configuration: Decodable {
+        var expectedTeamID: String
+        var targetUDID: String
+        var existingCertificatePath: String
+        var probeBundleIdentifier: String
+        var outputDirectory: String
+    }
+
+    private enum Failure: Error { case invalidConfiguration, wrongTeam, wrongIdentity, deviceMissing, invalidResponse, probeAlreadyExists }
+
+    /// Read-only legacy iOS query, also used by AltSign for free accounts.
+    private struct IOSDevicesRequest: DeveloperServicesRequest {
+        struct Device: Decodable, Sendable {
+            var deviceNumber: String?
+            var deviceId: String?
+        }
+        struct Response: Decodable, Sendable { var devices: [Device] }
+        var teamID: String
+        var action: String { "ios/listDevices" }
+        var parameters: [String: Any] { ["teamId": teamID, "DTDK_Platform": "ios"] }
+        func parse(_ response: Response) -> [Device] { response.devices }
+    }
+
+    private func emit(_ value: [String: Any]) throws {
+        let data = try JSONSerialization.data(withJSONObject: value, options: [.sortedKeys])
+        print(String(decoding: data, as: UTF8.self))
+    }
+
+    func run() async throws {
+        if mode == .storage {
+            @Dependency(\.keyValueStorage) var storage
+            let key = "SofaRenewalStorageCanary"
+            let canary = Data(UUID().uuidString.utf8)
+            try storage.setData(canary, forKey: key)
+            defer { try? storage.setData(nil, forKey: key) }
+            guard try storage.data(forKey: key) == canary else { throw Failure.invalidResponse }
+            try emit(["isolatedKeychainAccessible": true, "realCredentialsUsed": false])
+            return
+        }
+        if mode == .preflight {
+            @Dependency(\.anisetteDataProvider) var provider
+            let headers = try await provider.fetchAnisetteData()
+            guard !headers.machineID.isEmpty, !headers.oneTimePassword.isEmpty else { throw Failure.invalidResponse }
+            try emit(["nativeAnisetteAvailable": true, "thirdPartyServerContacted": false, "accountCredentialsUsed": false])
+            return
+        }
+
+        guard let configurationPath = ProcessInfo.processInfo.environment["SOFA_RENEWAL_PROBE_CONFIG"] else {
+            throw Failure.invalidConfiguration
+        }
+        let configuration = try JSONDecoder().decode(Configuration.self, from: Data(contentsOf: URL(fileURLWithPath: configurationPath)))
+        guard configuration.probeBundleIdentifier == "com.joeyteng.sofaremote.renewalprobe" else { throw Failure.invalidConfiguration }
+        let token = try AuthToken.saved()
+        guard case .xcode(let account) = token, account.teamID == configuration.expectedTeamID else { throw Failure.wrongTeam }
+        let client = DeveloperAPIClient(auth: token.authData())
+        let certificate = try Certificate(data: Data(contentsOf: URL(fileURLWithPath: configuration.existingCertificatePath)))
+        let certificates = try await DeveloperAPIPages {
+            try await client.certificatesGetCollection().ok.body.json
+        } next: {
+            $0.links.next
+        }
+        .map(\.data)
+        .reduce(into: [], +=)
+        let matchingCertificates = certificates.filter { $0.attributes?.serialNumber.map(certificate.hasSerialNumber) == true }
+        guard matchingCertificates.count == 1, let existingCertificate = matchingCertificates.first else { throw Failure.wrongIdentity }
+        if mode == .registerDevice {
+            let response = try await client.devicesCreateInstance(body: .json(.init(data: .init(
+                _type: .devices, attributes: .init(name: "Sofa Remote Test iPhone", platform: .init(.ios),
+                    udid: configuration.targetUDID)))))
+            if (try? response.conflict) != nil {
+                try emit(["deviceAlreadyRegistered": true, "newDeviceCreated": false, "existingCertificateMutated": false])
+            } else {
+                _ = try response.created
+                try emit(["deviceRegistrationSucceeded": true, "newDeviceCreated": true, "existingCertificateMutated": false])
+            }
+            return
+        }
+        let devices = try await DeveloperAPIPages {
+            try await client.devicesGetCollection(query: .init(
+                fields_lbrack_devices_rbrack_: [.udid, .platform, .status, .deviceClass], limit: 100)).ok.body.json
+        } next: {
+            $0.links.next
+        }
+        .map(\.data)
+        .reduce(into: [], +=)
+        let matchingDevices = devices.filter { $0.attributes?.udid?.caseInsensitiveCompare(configuration.targetUDID) == .orderedSame }
+        try emit(["deviceQueryCompleted": true, "returnedDeviceCount": devices.count,
+            "devicesWithUDIDCount": devices.filter { $0.attributes?.udid != nil }.count,
+            "returnedPlatforms": Array(Set(devices.compactMap { $0.attributes?.platform?.rawValue })).sorted(),
+            "matchingDeviceCount": matchingDevices.count, "accountMutated": false])
+        var deviceID = matchingDevices.count == 1 ? matchingDevices.first?.id : nil
+        if deviceID == nil {
+            guard case .xcode(let auth) = token.authData() else { throw Failure.wrongTeam }
+            let legacy = try await DeveloperServicesClient(authData: auth).send(IOSDevicesRequest(teamID: configuration.expectedTeamID))
+            let matches = legacy.filter { $0.deviceNumber?.caseInsensitiveCompare(configuration.targetUDID) == .orderedSame }
+            try emit(["legacyIOSDeviceQueryCompleted": true, "returnedDeviceCount": legacy.count,
+                "devicesWithUDIDCount": legacy.filter { $0.deviceNumber != nil }.count,
+                "matchingDeviceCount": matches.count, "accountMutated": false])
+            guard matches.count == 1 else { throw Failure.deviceMissing }
+            deviceID = matches.first?.deviceId
+        }
+        guard let deviceID else { throw Failure.deviceMissing }
+        let selectedIdentifier: String
+        switch mode {
+        case .appProfile: selectedIdentifier = "com.joeyteng.sofaremote.ios"
+        case .widgetProfile: selectedIdentifier = "com.joeyteng.sofaremote.ios.widgets"
+        case .macProfile: selectedIdentifier = "com.joeyteng.sofaremote.renewalprobe.mac"
+        default: selectedIdentifier = configuration.probeBundleIdentifier
+        }
+        let bundleIDs = try await DeveloperAPIPages {
+            try await client.bundleIdsGetCollection(query: .init(
+                filter_lbrack_identifier_rbrack_: [selectedIdentifier])).ok.body.json
+        } next: {
+            $0.links.next
+        }
+        .map(\.data)
+        .reduce(into: [], +=)
+        let matchingBundles = bundleIDs.filter { $0.attributes?.identifier == selectedIdentifier }
+        try emit(["bundleQueryCompleted": true, "exactMatchingCount": matchingBundles.count,
+            "returnedBundleCount": bundleIDs.count, "accountMutated": false])
+        if mode == .inspect {
+            try emit(["authenticatedToApple": true, "expectedTeamMatched": true, "existingCertificateMatched": true,
+                "registeredDeviceMatched": true, "probeIdentifierAlreadyExists": !matchingBundles.isEmpty, "accountMutated": false])
+            return
+        }
+        let bundle: Components.Schemas.BundleId
+        var createdBundle = false
+        if mode == .createProfile || (mode == .appProfile && matchingBundles.isEmpty) {
+            guard matchingBundles.isEmpty else { throw Failure.probeAlreadyExists }
+            bundle = try await client.bundleIdsCreateInstance(body: .json(.init(data: .init(
+                _type: .bundleIds, attributes: .init(name: "Sofa Remote Renewal Probe", platform: .init(.ios),
+                    identifier: selectedIdentifier))))).created.body.json.data
+            createdBundle = true
+        } else {
+            guard matchingBundles.count == 1, let existing = matchingBundles.first else { throw Failure.invalidResponse }
+            bundle = existing
+        }
+        let profile = try await client.profilesCreateInstance(body: .json(.init(data: .init(
+            _type: .profiles,
+            attributes: .init(name: "Sofa Remote \(mode.rawValue) \(UUID().uuidString)", profileType: .init(
+                mode == .macProfile ? .macAppDevelopment : .iosAppDevelopment)),
+            relationships: .init(bundleId: .init(data: .init(_type: .bundleIds, id: bundle.id)),
+                devices: .init(data: [.init(_type: .devices, id: deviceID)]),
+                certificates: .init(data: [.init(_type: .certificates, id: existingCertificate.id)]))
+        )))).created.body.json.data
+        guard let encoded = profile.attributes?.profileContent, let content = Data(base64Encoded: encoded) else {
+            throw Failure.invalidResponse
+        }
+        let directory = URL(fileURLWithPath: configuration.outputDirectory, isDirectory: true)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true,
+            attributes: [.posixPermissions: 0o700])
+        let destination = directory.appendingPathComponent("probe.mobileprovision")
+        try content.write(to: destination, options: [.atomic])
+        try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: destination.path)
+        try emit(["newProfileCreated": true, "reusedExistingCertificate": true, "existingCertificatesMutated": false,
+            "existingProfilesDeleted": false, "existingAppIDReused": !createdBundle, "profilePath": destination.path])
+    }
+}
