+#if os(macOS)
+import Foundation
+import Darwin
+
+@objc private protocol SofaAOSUtilities {
+    static func retrieveOTPHeadersForDSID(_ dsid: String) -> [String: Any]?
+    static var machineUDID: String? { get }
+}
+
+/// Local-only research backend: account authentication remains with Apple.
+public struct SofaNativeMacAnisetteProvider: AnisetteDataProvider {
+    public init() {}
+    public var providerID: String? { "sofa-native-aoskit-v1" }
+
+    private enum Failure: Error { case frameworkUnavailable, missingHeaders, invalidSystemInfo }
+
+    private func systemValue(_ name: String) throws -> String {
+        var count = 0
+        guard sysctlbyname(name, nil, &count, nil, 0) == 0, count > 1, count < 4096 else {
+            throw Failure.invalidSystemInfo
+        }
+        var bytes = [CChar](repeating: 0, count: count)
+        guard sysctlbyname(name, &bytes, &count, nil, 0) == 0 else { throw Failure.invalidSystemInfo }
+        return String(cString: bytes)
+    }
+
+    private func utilities() throws -> SofaAOSUtilities.Type {
+        guard let framework = Bundle(path: "/System/Library/PrivateFrameworks/AOSKit.framework") else {
+            throw Failure.frameworkUnavailable
+        }
+        try framework.loadAndReturnError()
+        guard let runtimeClass = NSClassFromString("AOSUtilities"),
+              runtimeClass.responds(to: NSSelectorFromString("retrieveOTPHeadersForDSID:")),
+              runtimeClass.responds(to: NSSelectorFromString("machineUDID")) else {
+            throw Failure.frameworkUnavailable
+        }
+        return unsafeBitCast(runtimeClass, to: SofaAOSUtilities.Type.self)
+    }
+
+    public func deviceInfo() async throws -> DeviceInfo {
+        guard let deviceID = try utilities().machineUDID, !deviceID.isEmpty else { throw Failure.missingHeaders }
+        let model = try systemValue("hw.model")
+        let build = try systemValue("kern.osversion")
+        let version = ProcessInfo.processInfo.operatingSystemVersion
+        let osVersion = "\(version.majorVersion).\(version.minorVersion).\(version.patchVersion)"
+        let cfNetworkVersion = Bundle(identifier: "com.apple.CFNetwork")?.infoDictionary?["CFBundleVersion"] as? String
+        guard let cfNetworkVersion, !cfNetworkVersion.isEmpty else { throw Failure.invalidSystemInfo }
+        return DeviceInfo(deviceID: deviceID,
+            clientInfo: "<\(model)> <macOS;\(osVersion);\(build)> <com.apple.AuthKit/1 (com.apple.akd/1.0)>",
+            akdUserAgent: "akd/1.0 CFNetwork/\(cfNetworkVersion)")
+    }
+
+    public func fetchAnisetteData() async throws -> AnisetteData {
+        guard let headers = try utilities().retrieveOTPHeadersForDSID("-2"),
+              let machine = headers["X-Apple-MD-M"] as? String, !machine.isEmpty,
+              let otp = headers["X-Apple-MD"] as? String, !otp.isEmpty else {
+            throw Failure.missingHeaders
+        }
+        let device = try await deviceInfo()
+        let routing = (headers["X-Apple-MD-RINFO"] as? NSNumber)?.uint64Value
+            ?? UInt64(headers["X-Apple-MD-RINFO"] as? String ?? "") ?? 84215040
+        return AnisetteData(clientTime: Date(), routingInfo: routing, machineID: machine,
+            localUserID: Data(device.deviceID.utf8).base64EncodedString(), oneTimePassword: otp, deviceInfo: device)
+    }
+}
+#endif
